# Zabbix
ZABBIX_URL=http://IP_ZABBIX_SERVER/zabbix
ZABBIX_API_TOKEN=ISI_TOKEN_ZABBIX_DISINI

# Email / SMTP
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=email@domain.com
SMTP_PASS=ISI_APP_PASSWORD_GMAIL
TO_EMAIL=penerima@domain.com

# Output path
BASE_OUTPUT_DIR=C:/Zabbix

# Server
APP_HOST=0.0.0.0
APP_PORT=8005

# WhatsApp alert NOC (opsional)
WA_ALERT_ENABLED=false
WA_ALERT_MODE=web            # 'web' (bridge whatsapp-alert/server.js) atau 'cloud' (Graph API)
WA_TO=628xxxxxxxxxx          # pisahkan koma untuk banyak nomor
WA_WEB_URL=http://127.0.0.1:3100/send
WA_WEB_SECRET=

# URL publik dashboard buat tombol "Kirim Link NOC" (kosong = pakai host request otomatis)
NOC_PUBLIC_URL=

# Rekap NOC bulanan + narasi AI (opsional)
NOC_REPORT_ENABLED=false     # true = kirim otomatis tiap tanggal 1 pukul 06:00 WIB
# Narasi AI: isi SALAH SATU key. Kosong dua-duanya = PDF tetap dibuat tanpa narasi.
# Gemini: ada free-tier (aistudio.google.com/apikey), cukup untuk 1 rekap/bulan.
GEMINI_API_KEY=
NOC_REPORT_GEMINI_MODEL=gemini-2.5-flash
# Anthropic: bayar-pakai (console.anthropic.com), dipakai kalau GEMINI_API_KEY kosong.
ANTHROPIC_API_KEY=
NOC_REPORT_MODEL=claude-opus-5
