# Zabbix
ZABBIX_URL=http://IP_ZABBIX_SERVER/zabbix
ZABBIX_API_TOKEN=ISI_TOKEN_ZABBIX_DISINI

# Email / SMTP
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=email@domain.com
SMTP_PASS=ISI_APP_PASSWORD_GMAIL
TO_EMAIL=penerima@domain.com

# Output path
BASE_OUTPUT_DIR=C:/Zabbix

# Server
APP_HOST=0.0.0.0
APP_PORT=8005

# WhatsApp alert NOC (opsional)
WA_ALERT_ENABLED=false
WA_ALERT_MIN_DOWN_SECONDS=300   # DOWN < 5 menit dan sudah pulih = tidak dikirim
NOC_REPORT_WA_SEND_PDF=false   # true = PDF rekap mingguan ikut dikirim ke WA
BANDWIDTH_BUSY_HOURS=07-17   # beban dinilai hanya jam ini (JJ-JJ); kosong = 24 jam
WA_ALERT_MODE=web            # 'web' (bridge whatsapp-alert/server.js), 'cloud' (Graph API) atau 'fonnte'
FONNTE_TOKEN=                # token device dari dashboard fonnte.com (dipakai kalau mode=fonnte)
WA_TO=628xxxxxxxxxx          # pisahkan koma untuk banyak nomor
WA_WEB_URL=http://127.0.0.1:3100/send
WA_WEB_SECRET=

# URL publik dashboard buat tombol "Kirim Link NOC" (kosong = pakai host request otomatis)
NOC_PUBLIC_URL=

# Rekap NOC + narasi AI (opsional)
NOC_REPORT_ENABLED=false     # true = kirim rekap mingguan otomatis tiap Senin pukul 09:00 WIB
# AI Hermes (Nous Research) via API kompatibel OpenAI — dipakai untuk narasi rekap
# DAN fitur chat "Tanya Jaringan" (/tanya). Kosong = narasi dilewati & chat nonaktif.
#   Ollama lokal : HERMES_BASE_URL=http://127.0.0.1:11434/v1   HERMES_MODEL=hermes3:8b
#   LM Studio    : HERMES_BASE_URL=http://127.0.0.1:1234/v1
#   OpenRouter   : HERMES_BASE_URL=https://openrouter.ai/api/v1  HERMES_MODEL=nousresearch/hermes-4-70b
#   Nous Portal  : HERMES_BASE_URL=https://inference-api.nousresearch.com/v1
#   Hermes Agent : HERMES_BASE_URL=http://127.0.0.1:8642/v1  HERMES_MODEL=hermes-agent
#                  HERMES_API_KEY = API_SERVER_KEY di ~/.hermes/.env, HERMES_USE_TOOLS=false
#                  (login model, mis. OAuth Claude, diatur di Hermes Agent; jalankan `hermes gateway`)
HERMES_BASE_URL=
HERMES_MODEL=hermes3:8b
HERMES_API_KEY=             # layanan online / Hermes Agent; Ollama/LM Studio kosongkan
HERMES_USE_TOOLS=true       # false untuk Hermes Agent: data jaringan dikirim langsung di prompt
HERMES_TIMEOUT=180          # detik; agent / model lokal bisa lambat
# Server MCP (endpoint /api/mcp) supaya Hermes Agent bisa mengambil data sendiri
# (pola trafik, Zabbix & MikroTik hanya-baca). Isi token acak; kosong = MCP mati.
# Daftarkan di Hermes (~/.hermes/config.yaml):
#   mcp_servers:
#     netrowatch:
#       url: https://<dashboard>/api/mcp
#       headers: { Authorization: "Bearer <MCP_TOKEN>" }
MCP_TOKEN=
# Anthropic: bayar-pakai (console.anthropic.com), cadangan narasi kalau Hermes kosong/gagal.
ANTHROPIC_API_KEY=
NOC_REPORT_MODEL=claude-opus-5

# Cakupan pemantauan (persen periode yang benar-benar terpolling).
# Di bawah MIN_COVERAGE_PCT, laporan memasang peringatan "data belum lengkap".
# Di bawah MIN_TREND_COVERAGE_PCT, perbandingan dengan periode lalu dimatikan
# supaya "100%" yang sebenarnya berarti "tidak ada data" tidak dipakai jadi tren.
NOC_REPORT_MIN_COVERAGE_PCT=90
NOC_REPORT_MIN_TREND_COVERAGE_PCT=70

# Kirim WA "pemantauan sempat mati" kalau jedanya >= nilai ini (detik). 0 = matikan.
# Penting: selama jeda tidak ada alert sama sekali, jadi sepi != aman.
NOC_BLACKOUT_NOTIFY_MIN_SECONDS=1800
